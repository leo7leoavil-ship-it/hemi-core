# ==============================================================================
# Tech Tutor Engine - Example Environment Configuration
# Copy to `.env` for local runs. In Hugging Face Spaces define the SECRETS
# (GROQ_API_KEY, API_TOKEN, HF_TOKEN) in Settings -> Variables and secrets.
# Never commit the real `.env`.
# ==============================================================================

# --- LLM Inference Core (Groq Cloud) -----------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_REASONING_EFFORT=low
LLM_STRUCTURED_OUTPUT=true

# --- API Authentication (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
# `API_TOKEN` is accepted as an alias of API_AUTH_TOKEN.
API_AUTH_TOKEN=your_secure_api_auth_token_here

# --- Vector Database (RAG Pipeline with ChromaDB) ----------------------------
CHROMA_PERSIST_DIRECTORY=./data/technical_corpus_db
CHROMA_COLLECTION_NAME=tech_tutor_corpus
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Corpus provisioning from the Hugging Face Hub (used when the DB is missing)
CORPUS_AUTO_DOWNLOAD=true
CORPUS_DATASET_REPO=leonardo-beltran/tech-tutor-corpus
HF_TOKEN=

# --- Automatic Speech Recognition (faster-whisper) ---------------------------
ASR_MODEL_NAME=large-v3-turbo
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4

# --- Server Runtime Settings (Hugging Face Spaces uses PORT=7860) ------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=["*"]
MAX_AUDIO_BYTES=5242880
MAX_AUDIO_SECONDS=60.0
ASR_MAX_CONCURRENCY=1
ASR_QUEUE_TIMEOUT_SECONDS=10.0
ASR_TIMEOUT_SECONDS=25.0
RAG_TIMEOUT_SECONDS=5.0
LLM_TIMEOUT_SECONDS=30.0

# --- Optional Gradio sandbox at /ui (needs `pip install gradio`) -------------
ENABLE_UI=false
